datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  ENTERPRISE
}

enum ExtractionStatus {
  SUCCESS
  WARNING
  FAILED
}

enum MatchingJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum MatchingItemStatus {
  PENDING
  DONE
  FAILED
  SKIPPED
}

model Company {
  id        String    @id @default(uuid())
  name      String
  key       String    @unique
  plan      String    @default("FREE")
  billingCycle String @default("MONTHLY")
  quotaMonth DateTime? @db.Date
  monthlyUsed Int     @default(0)
  users     User[]
  aiUsage   AiUsage[]

  @@map("companies")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String
  fullName           String
  companyName        String?
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role               UserRole
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  jobs               JobDescription[]
  createdJobs        JobDescription[] @relation("JobCreator")
  candidates         Candidate[]
  uploadedCandidates Candidate[] @relation("CandidateUploader")
  matchingJobs       MatchingJob[]
  aiUsage            AiUsage[]

  @@map("users")
  @@index([companyId])
}

model JobDescription {
  id             String        @id @default(uuid())
  title          String
  description    String        @db.Text
  requiredSkills String[]
  minExperience  Int           @default(0)
  preferredSkills  String[]   @default([])
  evaluationConfig Json?
  jdAnalysis       Json?
  evaluationVersion String    @default("cvtest-1.0")
  analyzedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  matchResults   MatchResult[]
  matchingJobs   MatchingJob[]
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?         @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("job_descriptions")
  @@index([ownerId])
  @@index([createdById])
}

model Candidate {
  id                String        @id @default(uuid())
  fullName          String
  email             String?
  phone             String?
  rawText           String        @default("") @db.Text
  pageCount         Int?
  searchText        String        @default("") @db.Text
  skills            String[]
  yearsOfExperience Int           @default(0)
  education         String?
  fileName          String
  fileUrl           String
  extractionStatus  ExtractionStatus @default(SUCCESS)
  extractionMessage String?
  contentHash       String?
  structuredProfile Json?
  profileVersion    String?
  profileAnalyzedAt DateTime?
  createdAt         DateTime      @default(now())
  matchResults      MatchResult[]
  jobItems          MatchingJobItem[]
  ownerId           String
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  uploadedById      String?
  uploadedBy        User?         @relation("CandidateUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("candidates")
  @@index([ownerId])
  @@index([createdAt(sort: Desc)])
  @@index([yearsOfExperience])
  @@index([skills], type: Gin)
  @@index([contentHash])
  @@index([uploadedById])
}

model IdempotencyKey {
  key          String   @id
  endpoint     String
  requestHash  String
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}

model MatchResult {
  id               String         @id @default(uuid())
  candidateId      String
  jobDescriptionId String
  score            Int
  summary          String         @db.Text
  matchedSkills    String[]
  missingSkills    String[]
  highlights       String[]       @default([])
  skillAnalysis    String[]       @default([])
  redFlags         String[]       @default([])
  interviewQuestions String[]     @default([])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime?      @updatedAt
  modelName        String?
  promptVersion    String?
  inputTokens      Int?
  outputTokens     Int?
  matchLevel       String?
  scoreBreakdown   Json?
  strengths        Json?
  gaps             Json?
  requirementsAnalysis Json?
  careerPotential  Json?
  confidence       String?
  limitations      Json?
  evidence         Json?
  evaluationConfig Json?
  evaluationVersion String       @default("cvtest-1.0")
  candidateProfileSnapshot Json?
  jdAnalysisSnapshot Json?

  candidate        Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobDescriptionId])
  @@map("match_results")
}

model MatchingJob {
  id               String            @id @default(uuid())
  jobDescriptionId String
  ownerId          String
  companyId        String?
  planName         String?
  quotaMonth       DateTime?         @db.Date
  status           MatchingJobStatus @default(QUEUED)
  total            Int
  processed        Int               @default(0)
  failed           Int               @default(0)
  cancelRequested  Boolean           @default(false)
  errorMessage     String?
  createdAt        DateTime          @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  jobDescription   JobDescription    @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items            MatchingJobItem[]

  @@index([status])
  @@index([jobDescriptionId, createdAt(sort: Desc)])
  @@index([ownerId])
  @@map("matching_jobs")
}

model MatchingJobItem {
  id           String             @id @default(uuid())
  jobId        String
  candidateId  String
  status       MatchingItemStatus @default(PENDING)
  attempts     Int                @default(0)
  errorCode    String?
  errorMessage String?
  finishedAt   DateTime?

  job          MatchingJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate    Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([jobId, status])
  @@map("matching_job_items")
}

model AiUsage {
  id           String   @id @default(uuid())
  enterpriseId String?
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  enterprise   User?    @relation(fields: [enterpriseId], references: [id], onDelete: SetNull)
  model        String
  inputTokens  Int?
  outputTokens Int?
  succeeded    Boolean
  createdAt    DateTime @default(now())
  day          DateTime @db.Date

  @@index([day])
  @@index([enterpriseId, day])
  @@index([companyId, day])
  @@map("ai_usage")
}
