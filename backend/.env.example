PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mikiricv?schema=public"
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=use-a-different-random-secret-at-least-32
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
